---
// A screenshot taken in both themes: the light one shows on the light site,
// the dark one on the dark site (Starlight's light:/dark:sl-hidden classes).
// With only `light` given, that one image shows in both themes.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	light: ImageMetadata;
	dark?: ImageMetadata;
	alt: string;
	caption?: string;
	// The pixel density the shot was taken at; most are 2x.
	scale?: number;
}
const { light, dark, alt, caption, scale = 2 } = Astro.props;
const width = Math.round(light.width / scale);
const densities = scale >= 2 ? [1, 2] : [1, scale];
---

<figure class="shot not-content">
	{dark ? (
		<Fragment>
			<Image class="dark:sl-hidden" src={light} alt={alt} width={width} densities={densities} />
			<Image class="light:sl-hidden" src={dark} alt={alt} width={width} densities={densities} />
		</Fragment>
	) : (
		<Image src={light} alt={alt} width={width} densities={densities} />
	)}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.shot {
		margin: 1.5rem 0;
	}
	/* No display rule here: Starlight's sl-hidden classes hide one of the two. */
	.shot img {
		vertical-align: top;
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
	.shot figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
</style>
