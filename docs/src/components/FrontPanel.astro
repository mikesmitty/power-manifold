---
// The chassis front panel, traced from the enclosure's front view.
//
// lights: up to seven entries, left to right: the chassis light, then ports
// 1 to 6. Each entry is a colour name from COLOURS, optionally followed by
// one of "dim", "blink" (2 Hz), "fast" (5 Hz), "pulse" (1 s) or "breathe"
// (2 s), for example "red fast", or null for an unlit light. The rates are
// the firmware's (firmware/controller/src/engine/led_pattern.c).
// sequence: play a pattern that runs across the whole row instead, at the
// firmware's timing: "boot" (the power-up sweep), "identify" or "hold" (the
// button held to a factory reset, with a timeline under the panel). Where a
// sequence leaves the row to its normal state, the lights above are shown,
// without their blink or pulse.
// labels: draw the callouts for the Ethernet port, the button and the lights.
interface Props {
	lights?: (string | null)[];
	sequence?: 'boot' | 'identify' | 'hold';
	labels?: boolean;
	title?: string;
	caption?: string;
}
const { lights = [], sequence, labels = !sequence && lights.length === 0, title = 'Power Manifold front panel', caption } = Astro.props;

const COLOURS: Record<string, string> = {
	white: '#e8e8e8',
	cyan: '#22d3ee',
	amber: '#f59e0b',
	blue: '#3b82f6',
	green: '#22c55e',
	red: '#ef4444',
};
// How bright a "dim" light is drawn: the firmware's dim amber and dim green
// are a few percent of full drive, which an LED shows as a faint glow.
const DIM = 0.4;

// x centres of the chassis light and ports 1 to 6
const LIGHT_X = [450, 617, 784, 950, 1117, 1284, 1451];
const PORT_X = LIGHT_X.slice(1);
const pins = Array.from({ length: 8 }, (_, i) => 172 + i * 10);

// Several panels can share a page, so their filter and animation names must not collide.
const uid = 'fp' + Math.random().toString(36).slice(2, 8);

type Frame = Record<string, number>[]; // per light: colour name -> level 0 to 1

const base = LIGHT_X.map((_, i) => {
	const spec = lights[i];
	if (!spec) return null;
	const [name, ...mods] = spec.split(' ');
	return { name, dim: mods.includes('dim'), mode: mods.filter((m) => m !== 'dim').join(' ') };
});
const baseFrame: Frame = base.map((b) => (b ? { [b.name]: b.dim ? DIM : 1 } : {}));
const none = (): Frame => LIGHT_X.map(() => ({}));

// Each sequence: its loop length, the moment to show still when the reader
// prefers reduced motion, and the row at time t (ms) within the loop.
const HOLD_LONG = 3000;
const HOLD_RESET = 10000;
const SEQUENCES: Record<string, { period: number; still: number; at: (t: number) => Frame }> = {
	// 150 ms per light from the chassis light on, all seven held for 300 ms
	boot: {
		period: 3000,
		still: 1300,
		at: (t) => (t < 1350 ? LIGHT_X.map((_, i) => (i <= Math.floor(t / 150) ? { white: 1 } : {})) : baseFrame),
	},
	// every other light blue, swapping every 250 ms
	identify: {
		period: 500,
		still: 0,
		at: (t) => LIGHT_X.map((_, i) => ((Math.floor(t / 250) + i) & 1 ? { blue: 1 } : {})),
	},
	// normal until 3 s, then filling in blue one light at a time, all red as
	// the reset fires at 10 s, then dark while the controller restarts
	hold: {
		period: 14000,
		still: 7000,
		at: (t) => {
			if (t < HOLD_LONG) return baseFrame;
			if (t < HOLD_RESET) {
				const span = ((t - HOLD_LONG) / (HOLD_RESET - HOLD_LONG)) * LIGHT_X.length;
				return LIGHT_X.map((_, i) => ({ blue: Math.min(1, Math.max(0, span - i)) }));
			}
			if (t < 11500) return LIGHT_X.map(() => ({ red: 1 }));
			return none();
		},
	},
};

// One layer per light and colour. A sequence animates each layer's opacity
// through keyframes sampled from its function; a run of samples on one
// straight line collapses to its two ends.
const pct = (t: number, period: number) => +((t / period) * 100).toFixed(3);
let css = '';
const layers = LIGHT_X.map((x, i) => {
	if (!sequence) {
		const b = base[i];
		if (!b) return [];
		return [{ colour: COLOURS[b.name] ?? b.name, cls: `fp-lit ${b.mode}`, level: b.dim ? DIM : 1 }];
	}
	const seq = SEQUENCES[sequence];
	const step = 10;
	const frames: Frame = [];
	for (let t = 0; t <= seq.period; t += step) frames.push(seq.at(t === seq.period ? 0 : t)[i]);
	const names = [...new Set(frames.flatMap((f) => Object.keys(f)))];
	return names.map((name) => {
		const v = frames.map((f) => f[name] ?? 0);
		const keep = v.map((_, k) => k === 0 || k === v.length - 1 || Math.abs(v[k] - v[k - 1] - (v[k + 1] - v[k])) > 1e-6);
		const stops = v.flatMap((level, k) => (keep[k] ? [`${pct(k * step, seq.period)}%{opacity:${+level.toFixed(3)}}`] : []));
		const cls = `${uid}-${i}-${name}`;
		css += `@keyframes ${cls}{${stops.join('')}}.${cls}{animation:${cls} ${seq.period}ms linear infinite}`;
		css += `@media (prefers-reduced-motion:reduce){.${cls}{animation-play-state:paused;animation-delay:-${seq.still}ms}}`;
		return { colour: COLOURS[name] ?? name, cls: `fp-lit ${cls}`, level: v[0] };
	});
});

// The hold sequence gets a timeline under the panel, so the reader can see
// how long the button has been held.
const timeline = sequence === 'hold';
const TL = { x0: 100, x1: 1900, y: 540 };
const tlx = (ms: number) => TL.x0 + ((TL.x1 - TL.x0) * ms) / SEQUENCES.hold.period;
if (timeline) {
	const n = `${uid}-marker`;
	css += `@keyframes ${n}{from{transform:translateX(0)}to{transform:translateX(${TL.x1 - TL.x0}px)}}.${n}{animation:${n} ${SEQUENCES.hold.period}ms linear infinite}`;
	css += `@media (prefers-reduced-motion:reduce){.${n}{animation-play-state:paused;animation-delay:-${SEQUENCES.hold.still}ms}}`;
}

const top = labels ? -80 : 0;
const height = labels ? 80 + 610 : timeline ? 640 : 458;
---

<figure class="front-panel not-content">
	{css && <style is:inline set:html={css} />}
	<svg viewBox={`0 ${top} 2000 ${height}`} role="img" aria-label={title}>
		<title>{title}</title>
		<defs>
			<filter id={`${uid}-glow`} x="-200%" y="-200%" width="500%" height="500%">
				<feGaussianBlur stdDeviation="9" />
			</filter>
		</defs>

		<!-- panel and its folded side flanges -->
		<rect class="fp-face" x="20" y="22" width="1957" height="414" rx="4" />
		<line class="fp-line" x1="37" y1="22" x2="37" y2="436" />
		<line class="fp-line" x1="1960" y1="22" x2="1960" y2="436" />

		<!-- Ethernet jack -->
		<g class="fp-line">
			<rect x="128" y="183" width="158" height="132" rx="2" />
			<path d="M148 212 V238 H160 V268 H176 V288 H238 V268 H254 V238 H266 V212 Z" />
			{pins.map((x) => <line x1={x} y1="214" x2={x} y2="232" />)}
			<rect x="145" y="293" width="22" height="14" />
			<rect x="247" y="293" width="22" height="14" />
		</g>

		<!-- button -->
		<rect class="fp-line fp-button" x="308" y="299" width="20" height="13" rx="2" />

		<!-- lights: the hole, with any lit layers over it -->
		{LIGHT_X.map((x, i) => (
			<g>
				<circle class="fp-line fp-hole" cx={x} cy="87" r="10" />
				{layers[i].map(({ colour, cls, level }) => (
					<g class={cls} style={`--led:${colour};opacity:${level}`}>
						<circle cx={x} cy="87" r="20" filter={`url(#${uid}-glow)`} />
						<circle cx={x} cy="87" r="10" />
					</g>
				))}
			</g>
		))}

		<!-- port numbers and USB-C receptacles -->
		{PORT_X.map((x, i) => (
			<g>
				<text class="fp-num" x={x} y="158">{i + 1}</text>
				<rect class="fp-line" x={x - 17} y="186" width="34" height="86" rx="17" />
				<rect class="fp-line fp-port" x={x - 11} y="192" width="22" height="74" rx="11" />
				<rect class="fp-tongue" x={x - 3} y="204" width="6" height="50" rx="2" />
			</g>
		))}

		<!-- wordmark: Eurostile Extended Black outlines from the front plate's text DXF -->
		<path class="fp-mark" d="M1665.8,333.2 1665.8,297.9 1693.9,297.9 1699.4,298.1 1701.4,298.4 1703.2,299.1 1704.9,300.1 1706.2,301.4 1707.4,303.5 1708.1,306.0 1708.4,309.5 1708.3,313.7 1708.0,316.7 1707.3,319.1 1706.3,321.0 1704.8,322.5 1703.7,323.3 1702.3,323.8 1698.7,324.4 1676.5,324.5 1676.5,333.2Z M1676.5,316.0 1692.6,316.0 1695.7,315.5 1696.9,314.8 1697.5,313.4 1697.7,311.0 1697.4,308.8 1696.9,307.9 1696.3,307.3 1695.2,306.8 1693.8,306.6 1676.5,306.5Z M1738.5,297.6 1749.5,297.7 1754.8,298.2 1757.1,298.9 1758.9,299.8 1760.4,301.0 1761.5,302.5 1762.7,305.3 1763.2,308.6 1763.4,316.6 1763.2,322.3 1762.6,325.4 1761.8,327.8 1760.4,329.8 1758.5,331.3 1757.0,332.0 1755.1,332.7 1750.4,333.4 1739.2,333.6 1727.6,333.3 1723.8,332.9 1721.0,332.0 1718.8,330.6 1717.2,328.7 1716.2,326.4 1715.6,323.7 1715.3,320.0 1715.2,314.1 1715.4,309.8 1715.8,306.4 1716.4,304.2 1717.4,302.3 1718.6,301.0 1720.1,299.9 1721.9,299.0 1724.1,298.4 1728.9,297.7Z M1739.3,306.2 1733.7,306.3 1730.5,306.6 1728.4,307.2 1727.3,308.2 1726.7,309.2 1726.4,310.3 1726.1,314.7 1726.3,320.2 1726.6,321.6 1727.1,322.8 1727.9,323.7 1729.2,324.3 1730.8,324.7 1733.0,324.9 1740.3,325.0 1746.2,324.8 1748.8,324.5 1750.6,323.8 1751.3,323.1 1752.0,322.1 1752.6,319.2 1752.7,311.8 1751.9,308.3 1750.7,307.2 1749.4,306.7 1744.9,306.2Z M1768.7,297.9 1779.6,297.9 1789.8,324.8 1799.0,297.9 1811.9,297.9 1820.8,324.8 1831.3,297.9 1842.2,297.9 1827.6,333.2 1813.2,333.2 1805.4,307.8 1797.2,333.2 1782.9,333.2Z M1848.2,297.9 1887.3,297.9 1887.3,305.9 1858.8,305.9 1858.8,312.0 1885.7,312.0 1885.7,319.0 1858.8,319.0 1858.8,325.2 1887.7,325.2 1887.7,333.2 1848.2,333.2Z M1895.6,333.2 1895.6,297.9 1926.4,297.9 1930.4,298.1 1933.1,298.4 1935.1,299.0 1936.8,299.9 1938.1,301.2 1939.2,303.5 1939.9,306.4 1940.0,310.6 1939.6,314.2 1938.9,316.3 1937.8,317.8 1936.1,319.0 1934.0,319.7 1935.8,320.2 1937.3,320.9 1938.3,321.8 1938.9,322.9 1939.3,324.2 1939.5,325.9 1939.6,333.2 1928.7,333.2 1928.7,328.0 1928.1,325.8 1927.5,325.1 1926.7,324.7 1923.5,324.3 1906.3,324.3 1906.3,333.2Z M1906.3,315.7 1923.8,315.7 1927.4,315.3 1928.5,314.6 1929.1,313.3 1929.3,310.9 1929.0,308.7 1928.6,307.9 1928.0,307.3 1927.2,306.9 1926.2,306.7 1906.3,306.6Z M1551.5,386.1 1551.5,350.8 1568.6,350.8 1581.4,374.3 1594.2,350.8 1611.1,350.8 1611.1,386.1 1600.7,386.1 1601.2,358.9 1585.5,386.1 1577.0,386.1 1561.6,358.9 1561.9,386.1Z M1616.1,386.1 1635.9,350.8 1650.3,350.8 1669.6,386.1 1657.9,386.1 1654.4,379.8 1631.6,379.8 1628.3,386.1Z M1635.5,372.5 1650.6,372.5 1643.0,358.4Z M1674.5,386.1 1674.5,350.8 1691.6,350.8 1713.0,377.6 1712.7,350.8 1722.9,350.8 1722.9,386.1 1705.6,386.1 1684.6,359.6 1684.9,386.1Z M1732.0,386.1 1732.0,350.8 1742.8,350.8 1742.8,386.1Z M1752.0,386.1 1752.0,350.8 1789.4,350.8 1789.4,358.8 1762.7,358.8 1762.7,365.9 1788.1,365.9 1788.1,373.8 1762.7,373.8 1762.7,386.1Z M1819.2,350.5 1830.2,350.6 1835.5,351.1 1837.8,351.8 1839.6,352.7 1841.1,353.9 1842.2,355.4 1843.3,358.2 1843.9,361.5 1844.1,369.5 1843.8,375.2 1843.3,378.3 1842.5,380.7 1841.1,382.6 1839.2,384.2 1837.7,384.9 1835.8,385.6 1831.1,386.3 1819.9,386.5 1808.3,386.2 1804.5,385.8 1801.7,384.9 1799.5,383.5 1797.9,381.6 1796.9,379.3 1796.3,376.6 1796.0,372.9 1795.9,367.0 1796.1,362.7 1796.5,359.3 1797.1,357.1 1798.1,355.2 1799.2,353.9 1800.7,352.8 1802.6,351.9 1804.8,351.2 1809.6,350.6Z M1820.0,359.1 1814.4,359.2 1811.2,359.5 1809.1,360.1 1808.0,361.1 1807.4,362.1 1807.1,363.2 1806.8,367.6 1807.0,373.1 1807.3,374.5 1807.8,375.7 1808.6,376.6 1809.8,377.2 1811.5,377.6 1813.7,377.8 1821.0,377.9 1826.9,377.7 1829.5,377.4 1831.3,376.7 1832.0,376.0 1832.7,375.0 1833.3,372.1 1833.4,364.7 1832.6,361.2 1831.4,360.1 1830.1,359.6 1825.5,359.1Z M1852.5,386.1 1852.5,350.8 1863.3,350.8 1863.3,377.4 1887.6,377.4 1887.6,386.1Z M1893.2,386.1 1893.2,350.8 1924.3,350.8 1929.2,351.1 1932.3,351.6 1934.7,352.4 1936.6,353.7 1938.2,355.5 1939.4,358.1 1940.1,362.0 1940.4,368.3 1940.2,375.0 1939.7,378.2 1939.0,380.4 1937.6,382.5 1935.7,384.2 1934.3,385.0 1932.8,385.5 1928.2,386.1Z M1903.9,377.7 1923.4,377.7 1925.9,377.4 1927.5,376.7 1928.4,376.0 1928.9,374.9 1929.3,373.4 1929.5,371.2 1929.6,367.8 1929.4,365.1 1929.0,363.1 1928.4,361.6 1927.7,360.8 1926.7,360.3 1923.8,359.7 1903.9,359.6Z" />

		{labels && (
			<g class="fp-callouts">
				<line x1="450" y1="70" x2="450" y2="-20" />
				<text x="450" y="-34">Chassis light</text>

				<path d="M617 70 V40 M617 40 H1451 M1451 70 V40 M1034 40 V-20" />
				<text x="1034" y="-34">Port lights</text>

				<line x1="207" y1="315" x2="207" y2="490" />
				<text x="190" y="534">Ethernet</text>

				<line x1="318" y1="312" x2="318" y2="490" />
				<text x="318" y="588">Button</text>
				<line x1="318" y1="490" x2="318" y2="545" />

				<path d="M617 290 V470 M617 470 H1451 M1451 290 V470 M1034 470 V490" />
				<text x="1034" y="534">USB-C ports 1 to 6</text>
			</g>
		)}
		{timeline && (
			<g class="fp-timeline">
				<line class="fp-axis" x1={TL.x0} y1={TL.y} x2={TL.x1} y2={TL.y} />
				<line class="fp-span" x1={tlx(HOLD_LONG)} y1={TL.y} x2={tlx(HOLD_RESET)} y2={TL.y} />
				{[0, HOLD_LONG, HOLD_RESET].map((ms) => <line class="fp-axis" x1={tlx(ms)} y1={TL.y - 18} x2={tlx(ms)} y2={TL.y + 18} />)}
				<text class="fp-start" x={tlx(0) - 16} y={TL.y + 70}>Press</text>
				<text x={tlx(HOLD_LONG)} y={TL.y + 70}>3 s</text>
				<text x={tlx(HOLD_RESET)} y={TL.y + 70}>10 s: reset</text>
				<circle class={`fp-marker ${uid}-marker`} cx={TL.x0} cy={TL.y} r="16" />
			</g>
		)}
	</svg>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.front-panel {
		margin: 1.5rem 0;
	}
	.front-panel svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.fp-face {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
	}
	.fp-line,
	.fp-line * {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.75;
		vector-effect: non-scaling-stroke;
	}
	.fp-port {
		fill: var(--sl-color-black);
	}
	.fp-tongue {
		fill: var(--sl-color-gray-3);
	}
	.fp-hole {
		fill: var(--sl-color-black);
	}
	.fp-button {
		fill: var(--sl-color-gray-4);
	}
	.fp-num {
		fill: var(--sl-color-gray-2);
		font: 600 36px var(--sl-font, sans-serif);
		text-anchor: middle;
	}
	.fp-mark {
		fill: var(--sl-color-gray-3);
		fill-rule: evenodd;
	}
	.fp-lit circle {
		fill: var(--led);
	}
	.fp-lit circle:first-child {
		opacity: 0.6;
	}
	/* The firmware's rates: a blink is on half the time and fully off the
	   other half, a pulse is a triangle between about 12 % and full. */
	.fp-lit.blink {
		animation: fp-blink 500ms steps(1) infinite;
	}
	.fp-lit.fast {
		animation: fp-blink 200ms steps(1) infinite;
	}
	.fp-lit.pulse {
		animation: fp-pulse 1s linear infinite;
	}
	.fp-lit.breathe {
		animation: fp-pulse 2s linear infinite;
	}
	@keyframes fp-blink {
		50% { opacity: 0; }
	}
	@keyframes fp-pulse {
		0%, 100% { opacity: 0.12; }
		50% { opacity: 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.fp-lit.blink,
		.fp-lit.fast,
		.fp-lit.pulse,
		.fp-lit.breathe { animation: none; }
	}
	.fp-timeline text {
		fill: var(--sl-color-gray-2);
		font: 500 40px var(--sl-font, sans-serif);
		text-anchor: middle;
	}
	.fp-timeline .fp-start {
		text-anchor: start;
	}
	.fp-axis {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
		vector-effect: non-scaling-stroke;
	}
	.fp-span {
		stroke: var(--sl-color-accent);
		stroke-width: 4;
		vector-effect: non-scaling-stroke;
	}
	.fp-marker {
		fill: var(--sl-color-white);
	}
	.front-panel figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
	.fp-callouts line,
	.fp-callouts path {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 1.25;
		vector-effect: non-scaling-stroke;
	}
	.fp-callouts text {
		fill: var(--sl-color-white);
		font: 500 46px var(--sl-font, sans-serif);
		text-anchor: middle;
	}
</style>
