---
// The chassis right side plate, traced from its marking DXF
// (export/Right Side Plate Text.dxf): the outline, the fan opening and its
// screw holes, the XT60 power input and its laser-etched markings. Units are
// tenths of a millimetre, from the top left of the plate.
//
// labels: draw the callouts for the power input, the fan and the front.
interface Props {
	labels?: boolean;
	title?: string;
}
const { labels = true, title = 'Power Manifold right side, with the XT60 power input and the fan exhaust' } = Astro.props;

const FAN = { cx: 690, cy: 220, r: 195 };
const SCREWS = [
	[530, 60],
	[850, 60],
	[530, 380],
	[850, 380],
];
// XT60 pins: negative above, positive below, as the etched marks say
const PINS = [
	{ cy: 119.48, sign: 'negative' },
	{ cy: 191.48, sign: 'positive' },
];
const PIN_X = 1022.09;
// The tabs' extents along the edge; they are the same top and bottom.
const TABS = [
	[235, 470],
	[910, 1120.5],
];
const BLADES = Array.from({ length: 7 }, (_, i) => (i * 360) / 7);

const top = labels ? -110 : -10;
const height = labels ? 110 + 440 + 120 : 460;
---

<figure class="side-panel not-content">
	<svg viewBox={`-20 ${top} 1190 ${height}`} role="img" aria-label={title}>
		<title>{title}</title>

		<path class="sp-face" d="M27.49,0 132.11,0 230,2 1122.5,2 1150,29.49 1150,410.5 1122.51,438 230,438 132.11,440 27.49,440 0,412.5 0,27.5Z" />

		<!-- the tabs along the top and bottom edges, bent inward to join the
		     top and bottom shell: a bend line, and a relief slot at each end -->
		{TABS.map(([x0, x1]) => (
			<g class="sp-tab">
				<line x1={x0 + 10} y1="22" x2={x1 - 10} y2="22" />
				<line x1={x0 + 10} y1="418" x2={x1 - 10} y2="418" />
				{[x0, x1 - 10].map((x) => (
					<g>
						<path class="sp-relief" d={`M${x} 2 V45 a5 5 0 0 0 10 0 V2 Z`} />
						<path class="sp-relief" d={`M${x} 438 V395 a5 5 0 0 1 10 0 V438 Z`} />
					</g>
				))}
			</g>
		))}

		<!-- fan opening, with the fan behind it -->
		<circle class="sp-hole" cx={FAN.cx} cy={FAN.cy} r={FAN.r} />
		<g class="sp-fan">
			{BLADES.map((a) => (
				<path transform={`rotate(${a} ${FAN.cx} ${FAN.cy})`} d={`M${FAN.cx + 62} ${FAN.cy - 8} Q${FAN.cx + 120} ${FAN.cy - 70} ${FAN.cx + 170} ${FAN.cy - 40} Q${FAN.cx + 130} ${FAN.cy + 5} ${FAN.cx + 62} ${FAN.cy + 22} Z`} />
			))}
			<circle cx={FAN.cx} cy={FAN.cy} r="62" />
		</g>
		{SCREWS.map(([x, y]) => <circle class="sp-hole sp-screw" cx={x} cy={y} r="21.5" />)}

		<!-- laser-etched markings: polarity leaders and the input rating -->
		<g class="sp-print">
			<path d="M1021.64,225 1021.64,260" />
			<path d="M1022.09,191.48 1097.64,191.48" />
			<path d="M1022.09,119.48 1097.64,119.48" />
